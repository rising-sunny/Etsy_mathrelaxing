# Lulu Print API - copy to lulu_books/.env (NEVER commit .env)
# https://developers.lulu.com/
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_SANDBOX=0

# Preferred: public URLs on mathrelaxing.store (after publish-pdfs + VPS deploy)
# Lulu fetches {PDF_PUBLIC_BASE}/{public_slug}/interior.pdf and cover.pdf
PDF_PUBLIC_BASE=https://mathrelaxing.store/static/downloads

# Optional fallback: Cloudflare R2 (only if PDF_PUBLIC_BASE is unset)
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=mathrelaxing-print
# R2_PUBLIC_URL_BASE=https://print.mathrelaxing.store
