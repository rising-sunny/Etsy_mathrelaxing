# Lulu Print API credentials (see https://developers.lulu.com/)
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# 1 = sandbox (safe testing), 0 = production (real print jobs, real money)
LULU_SANDBOX=1

# Lulu fetches interior/cover PDFs from a PUBLIC url — this repo has no web
# server of its own. Host the files in output/hosted/ somewhere public
# (your own site, S3 + CloudFront, etc.) and set these to match:
LULU_DOWNLOADS_DIR=
LULU_DOWNLOADS_URL=
